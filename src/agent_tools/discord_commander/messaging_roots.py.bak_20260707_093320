"""Resolve active AgentTools / DreamVault / coords roots for !message delivery."""

from __future__ import annotations
# D2A_AGENTTOOLS_BRIDGE_ENV_DEFAULTS_035
# Canonical visible-session D2A delivery defaults.
import os as _dreamos_d2a_env_035
_dreamos_d2a_env_035.environ["AGENT_CELLPHONE_ROOT"] = r"D:\repos\Agent_Cellphone"
_dreamos_d2a_env_035.environ.setdefault("ALLOW_LIVE_CURSOR_INJECTION", "1")
_dreamos_d2a_env_035.environ.setdefault("DEFAULT_MODE", "pyautogui")
_dreamos_d2a_env_035.environ.setdefault("COORDINATE_MODE", "4-agent-1monitor")
_dreamos_d2a_env_035.environ.setdefault("AGENT_GAS_LAYOUT_MODE", "4-agent-1monitor")
_dreamos_d2a_env_035.environ.setdefault("DREAMOS_ALLOW_PYAUTOGUI_FAILSAFE_OVERRIDE", "1")
_dreamos_d2a_env_035.environ.setdefault("PYTHONPATH", r"D:\agent-tools\src;D:\DreamVault\src")

import os
from pathlib import Path
from typing import Any

from .pyautogui_transport import resolve_agent_cellphone_root, ssot_coords_available
from .template_bridge import resolve_dreamvault_root


def resolve_agent_tools_root() -> Path:
    """Active agent-tools install (package dir or AGENT_TOOLS_ROOT env)."""
    env = os.environ.get("AGENT_TOOLS_ROOT", "").strip()
    if env:
        path = Path(env)
        if path.is_dir():
            return path.resolve()
    here = Path(__file__).resolve()
    # .../agent-tools/src/agent_tools/discord_commander/messaging_roots.py
    candidate = here.parents[3]
    if (candidate / "src" / "agent_tools").is_dir():
        return candidate.resolve()
    fallback = Path(r"D:\agent-tools")
    return fallback.resolve() if fallback.is_dir() else candidate.resolve()


def resolve_coords_root() -> Path:
    """SSOT coords prefer DreamVault agent_transport; else legacy Agent_Cellphone."""
    dv = resolve_dreamvault_root()
    if dv is not None and ssot_coords_available(dv):
        return dv
    acp = resolve_agent_cellphone_root()
    if acp is not None:
        return acp
    dv = resolve_dreamvault_root()
    if dv is not None:
        return dv
    return resolve_agent_tools_root()


def apply_messaging_roots() -> dict[str, Any]:
    """Normalize env for Commander !message — returns resolved paths for audit."""
    agent_tools = resolve_agent_tools_root()
    dreamvault = resolve_dreamvault_root() or Path(os.environ.get("DREAMVAULT_ROOT", r"D:\DreamVault"))
    coords_root = resolve_coords_root()
    acp = resolve_agent_cellphone_root()

    os.environ["AGENT_TOOLS_ROOT"] = str(agent_tools)
    if dreamvault.is_dir():
        os.environ.setdefault("DREAMVAULT_ROOT", str(dreamvault.resolve()))
    if acp is not None:
        os.environ.setdefault("AGENT_CELLPHONE_ROOT", str(acp.resolve()))
    if dreamvault.is_dir() and ssot_coords_available(dreamvault):
        os.environ.setdefault("DREAMVAULT_AGENT_TRANSPORT_SSOT", "1")
        os.environ.setdefault("DREAMVAULT_REPO_ROOT", str(dreamvault.resolve()))

    return {
        "agent_tools_root": str(agent_tools),
        "dreamvault_root": str(dreamvault) if dreamvault.is_dir() else None,
        "coords_root": str(coords_root),
        "agent_cellphone_root": str(acp) if acp else None,
        "transport_ssot": ssot_coords_available(dreamvault) if dreamvault.is_dir() else False,
    }


def commander_config_summary() -> dict[str, Any]:
    """Operator-visible root snapshot (no secrets)."""
    roots = apply_messaging_roots()
    return {
        **roots,
        "live_injection": os.environ.get("ALLOW_LIVE_CURSOR_INJECTION", "") == "1",
        "message_bus": os.environ.get("DISCORD_COMMANDER_USE_MESSAGE_BUS", "1"),
        "layout_mode": os.environ.get("AGENT_GAS_LAYOUT_MODE", "4-agent-1monitor"),
    }
