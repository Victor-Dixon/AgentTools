"""PyAutoGUI transport adapter — legacy Agent_Cellphone or DreamVault SSOT salvage."""

from __future__ import annotations
# D2A_AGENTTOOLS_TRANSPORT_ENV_DEFAULTS_032
import os as _dreamos_transport_env_032
_dreamos_transport_env_032.environ.setdefault("AGENT_CELLPHONE_ROOT", r"D:\repos\Agent_Cellphone")
_dreamos_transport_env_032.environ.setdefault("ALLOW_LIVE_CURSOR_INJECTION", "1")
_dreamos_transport_env_032.environ.setdefault("DEFAULT_MODE", "pyautogui")
_dreamos_transport_env_032.environ.setdefault("COORDINATE_MODE", "4-agent-1monitor")
_dreamos_transport_env_032.environ.setdefault("AGENT_GAS_LAYOUT_MODE", "4-agent-1monitor")
_dreamos_transport_env_032.environ.setdefault("DREAMOS_ALLOW_PYAUTOGUI_FAILSAFE_OVERRIDE", "1")

import logging
import os
import sys
from pathlib import Path
from typing import Optional

from .delivery_preflight import point_in_virtual_screen, resolve_layout_for_agent
from .models import DeliveryResult

logger = logging.getLogger(__name__)

_DEFAULT_ROOTS = (
    Path(os.environ.get("AGENT_CELLPHONE_ROOT", "")),
    Path(r"D:\Agent_Cellphone"),
)
_DREAMVAULT_DEFAULT = Path(r"D:\DreamVault")


def ssot_transport_enabled() -> bool:
    return os.environ.get("DREAMVAULT_AGENT_TRANSPORT_SSOT", "").strip() == "1"


def resolve_dreamvault_root() -> Path:
    env = os.environ.get("DREAMVAULT_REPO_ROOT", "").strip()
    return Path(env) if env else _DREAMVAULT_DEFAULT


def ssot_coords_available(root: Path | None = None) -> bool:
    repo = root or resolve_dreamvault_root()
    return (repo / "runtime" / "config" / "agent_transport" / "cursor_agent_coords.json").is_file()


def resolve_agent_cellphone_root() -> Optional[Path]:
    """Return legacy Agent_Cellphone repo root when agent_cell_phone.py is present."""
    if ssot_transport_enabled() and ssot_coords_available():
        return resolve_dreamvault_root()
    for root in _DEFAULT_ROOTS:
        if not root or not root.is_dir():
            continue
        if (root / "src" / "services" / "agent_cell_phone.py").is_file():
            return root
    return None


def ensure_agent_cellphone_path(root: Path) -> None:
    if ssot_transport_enabled() and ssot_coords_available(root):
        text = str(root)
        if text not in sys.path:
            sys.path.insert(0, text)
        return
    src = str(root / "src")
    if src not in sys.path:
        sys.path.insert(0, src)


class PyAutoGUITransport:
    """Thin adapter over AgentCellPhone (legacy repo or DreamVault SSOT salvage)."""

    def __init__(
        self,
        *,
        layout_mode: str | None = None,
        test: bool = False,
        root: Path | None = None,
    ) -> None:
        self._test = test
        self._use_ssot = ssot_transport_enabled() and (root is None or ssot_coords_available(root))
        self._root = root or resolve_agent_cellphone_root()
        if self._root is None:
            raise RuntimeError(
                "Agent_Cellphone not found. Set AGENT_CELLPHONE_ROOT, DREAMVAULT_AGENT_TRANSPORT_SSOT=1, "
                "or install at D:\\Agent_Cellphone."
            )
        ensure_agent_cellphone_path(self._root)
        self._layout_mode = layout_mode or os.environ.get("AGENT_GAS_LAYOUT_MODE", "").strip() or "4-agent-1monitor"
        self._acp = self._build_acp(self._layout_mode)

    def _build_acp(self, layout_mode: str):
        if self._use_ssot:
            from tools.agent_transport.core import AgentCellPhone  # type: ignore[import-not-found]

            return AgentCellPhone(agent_id="Discord-Commander", layout_mode=layout_mode, test=self._test)
        from services.agent_cell_phone import AgentCellPhone  # type: ignore[import-not-found]

        return AgentCellPhone(agent_id="Discord-Commander", layout_mode=layout_mode, test=self._test)

    def _ensure_layout_for_agent(self, agent_id: str) -> Optional[str]:
        layout, warning = resolve_layout_for_agent(self._root, agent_id)
        if layout != self._layout_mode:
            logger.warning(
                "Switching PyAutoGUI layout %s -> %s for %s",
                self._layout_mode,
                layout,
                agent_id,
            )
            self._layout_mode = layout
            self._acp = self._build_acp(layout)
        if warning:
            logger.warning(warning)
        return warning

    def send(self, agent_id: str, message: str, *, high_priority: bool = False) -> DeliveryResult:
        preflight_warning = self._ensure_layout_for_agent(agent_id)
        if self._use_ssot:
            try:
                import sys

                dv = self._root
                if str(dv) not in sys.path:
                    sys.path.insert(0, str(dv))
                from tools.agent_transport.shift_enter import force_bulk_paste_transport

                force_bulk_paste_transport()
            except Exception:
                pass
        agent = self._acp._fmt_id(agent_id)
        if agent not in self._acp._coords:
            detail = f"Agent {agent} not in layout {self._layout_mode}"
            logger.error(detail)
            return DeliveryResult(success=False, error_code="AGENT_NOT_IN_LAYOUT", detail=detail)

        input_loc = self._acp._coords[agent].get("input_box") or self._acp._coords[agent].get(
            "starter_location_box"
        )
        if input_loc:
            if self._use_ssot:
                in_bounds = point_in_virtual_screen(input_loc["x"], input_loc["y"])
            else:
                in_bounds = self._acp._coords_within_bounds(
                    agent, input_loc["x"], input_loc["y"], "input_box"
                )
            if not in_bounds:
                detail = (
                    f"{agent} input_box ({input_loc['x']}, {input_loc['y']}) outside virtual screen "
                    f"for layout {self._layout_mode}. Re-calibrate coords."
                )
                if preflight_warning:
                    detail = f"{detail} | preflight: {preflight_warning}"
                logger.error(detail)
                return DeliveryResult(success=False, error_code="COORDS_OUT_OF_BOUNDS", detail=detail)

        cursor = self._acp._cursor
        record_before = len(getattr(cursor, "record", []))
        try:
            if self._use_ssot:
                self._acp.send(agent_id, message, high_priority=high_priority)
            else:
                self._acp.send(
                    agent_id,
                    message,
                    high_priority=high_priority,
                    use_queue=False,
                )
        except Exception as exc:
            logger.exception("PyAutoGUI send failed for %s", agent_id)
            return DeliveryResult(
                success=False,
                error_code="PYAUTOGUI_EXCEPTION",
                detail=str(exc),
            )

        if hasattr(cursor, "record"):
            record_after = len(cursor.record)
            if record_after > record_before:
                return DeliveryResult(success=True, detail=preflight_warning)
            detail = "PyAutoGUI test cursor recorded no actions"
            logger.warning("%s for %s", detail, agent)
            return DeliveryResult(success=False, error_code="NO_CURSOR_ACTIVITY", detail=detail)

        logger.info("PyAutoGUI live send completed agent=%s layout=%s ssot=%s", agent, self._layout_mode, self._use_ssot)
        return DeliveryResult(success=True, detail=preflight_warning)


_transport_instance: PyAutoGUITransport | None = None


def get_default_transport(*, test: bool = False) -> PyAutoGUITransport | None:
    """Return a shared transport instance, or None when transport is unavailable."""
    global _transport_instance
    if test:
        return PyAutoGUITransport(test=True)
    if _transport_instance is not None:
        return _transport_instance
    try:
        _transport_instance = PyAutoGUITransport()
    except Exception as exc:
        logger.warning("PyAutoGUI transport unavailable: %s", exc)
        return None
    return _transport_instance


def reset_default_transport() -> None:
    """Clear cached transport (for tests or layout reload)."""
    global _transport_instance
    _transport_instance = None
