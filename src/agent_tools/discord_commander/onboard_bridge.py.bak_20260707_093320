"""Discord Commander → DreamVault onboard bridge (local PyAutoGUI only).

Soft/hard/group onboard must run on the Windows desktop with Cursor windows — never VPS webhook.
"""

from __future__ import annotations

import json
import logging
import os
import subprocess
import sys
from typing import Any

from agent_tools.discord_commander.env_bootstrap import bootstrap_commander_env
from agent_tools.discord_commander.models import OnboardResult
from agent_tools.discord_commander.template_bridge import resolve_dreamvault_root

logger = logging.getLogger(__name__)

QUAD_AGENTS = ("Agent-1", "Agent-2", "Agent-3", "Agent-4")


def _ensure_import(root) -> None:
    src = str(root / "src")
    scripts = str(root / "runtime" / "scripts")
    for path in (src, scripts):
        if path not in sys.path:
            sys.path.insert(0, path)


def _live_allowed() -> bool:
    return os.environ.get("ALLOW_LIVE_CURSOR_INJECTION", "").strip() == "1"


def _run_script(script_rel: str, args: list[str], *, root) -> tuple[int, str]:
    script = root / script_rel
    if not script.is_file():
        return 1, f"Missing script: {script}"
    env = os.environ.copy()
    env.setdefault("DREAMVAULT_ROOT", str(root))
    proc = subprocess.run(
        [sys.executable, str(script), *args],
        cwd=str(root),
        capture_output=True,
        text=True,
        env=env,
    )
    out = f"{proc.stdout or ''}{proc.stderr or ''}".strip()
    return proc.returncode, out


def quad_onboard_status() -> OnboardResult:
    """Read quad gas readiness (no PyAutoGUI)."""
    bootstrap_commander_env()
    root = resolve_dreamvault_root()
    if root is None:
        return OnboardResult(
            success=False,
            message="DreamVault root not found",
            action="quad_status",
            error_code="DREAMVAULT_MISSING",
        )
    try:
        _ensure_import(root)
        from dreamvault.agent_cellphone.cycle_policy import TASKS_BEFORE_ROLLOVER
        from dreamvault.agent_cellphone.group_onboard import assess_quad_readiness

        readiness = assess_quad_readiness()
        data = readiness.to_dict()
        data["tasks_before_rollover"] = TASKS_BEFORE_ROLLOVER
        msg = (
            f"Quad {readiness.ready_count}/{readiness.total_agents} ready "
            f"({TASKS_BEFORE_ROLLOVER}/{TASKS_BEFORE_ROLLOVER} gas) "
            f"all_ready={readiness.all_ready} cycle={readiness.quad_cycle_number}"
        )
        return OnboardResult(success=True, message=msg, action="quad_status", data=data)
    except Exception as exc:
        logger.exception("quad onboard status failed")
        return OnboardResult(
            success=False,
            message=str(exc),
            action="quad_status",
            error_code="STATUS_FAILED",
        )


def soft_onboard_agent(agent_id: str, *, live: bool = True) -> OnboardResult:
    """Soft onboard one agent via DreamVault SSOT (PyAutoGUI)."""
    bootstrap_commander_env()
    root = resolve_dreamvault_root()
    if root is None:
        return OnboardResult(
            success=False,
            message="DreamVault root not found",
            action="soft_onboard",
            error_code="DREAMVAULT_MISSING",
        )
    if live and not _live_allowed():
        return OnboardResult(
            success=False,
            message="ALLOW_LIVE_CURSOR_INJECTION=1 required for live soft onboard",
            action="soft_onboard",
            error_code="LIVE_BLOCKED",
        )
    try:
        _ensure_import(root)
        from agent_tools.discord_commander.agent_message_sender import normalize_agent_id
        from dreamvault.agent_cellphone.soft_onboard import run_soft_onboard

        normalized = normalize_agent_id(agent_id)
        if not normalized:
            return OnboardResult(
                success=False,
                message=f"Invalid agent id: {agent_id!r}",
                action="soft_onboard",
                error_code="INVALID_AGENT",
            )
        row = run_soft_onboard(normalized, live=live)
        data: dict[str, Any] = {
            "agent": row.agent,
            "mode": row.mode,
            "closeout_path": str(row.closeout_path) if row.closeout_path else None,
        }
        return OnboardResult(
            success=row.success,
            message=row.message,
            action="soft_onboard",
            data=data,
            error_code=None if row.success else "SOFT_ONBOARD_FAILED",
        )
    except Exception as exc:
        logger.exception("soft onboard failed for %s", agent_id)
        return OnboardResult(
            success=False,
            message=str(exc),
            action="soft_onboard",
            error_code="SOFT_ONBOARD_ERROR",
        )


def hard_onboard_agent(agent_id: str, *, live: bool = True) -> OnboardResult:
    """Hard onboard one agent: closeout → new chat → S2A onboard."""
    bootstrap_commander_env()
    root = resolve_dreamvault_root()
    if root is None:
        return OnboardResult(
            success=False,
            message="DreamVault root not found",
            action="hard_onboard",
            error_code="DREAMVAULT_MISSING",
        )
    if live and not _live_allowed():
        return OnboardResult(
            success=False,
            message="ALLOW_LIVE_CURSOR_INJECTION=1 required for live hard onboard",
            action="hard_onboard",
            error_code="LIVE_BLOCKED",
        )
    from agent_tools.discord_commander.agent_message_sender import normalize_agent_id

    normalized = normalize_agent_id(agent_id)
    if not normalized:
        return OnboardResult(
            success=False,
            message=f"Invalid agent id: {agent_id!r}",
            action="hard_onboard",
            error_code="INVALID_AGENT",
        )
    args = ["--agent", normalized]
    if live:
        args.append("--live")
    code, out = _run_script("runtime/scripts/agent_hard_onboard_001.py", args, root=root)
    success = code == 0 and "HARD_ONBOARD_PASS" in out
    return OnboardResult(
        success=success,
        message=out[-1200:] if out else f"exit {code}",
        action="hard_onboard",
        data={"agent": normalized, "exit_code": code},
        error_code=None if success else "HARD_ONBOARD_FAILED",
    )


def quad_group_onboard(*, live: bool = True, dry_run: bool = False, force: bool = False) -> OnboardResult:
    """Group onboard all quad agents when ready (or --force)."""
    bootstrap_commander_env()
    root = resolve_dreamvault_root()
    if root is None:
        return OnboardResult(
            success=False,
            message="DreamVault root not found",
            action="quad_group_onboard",
            error_code="DREAMVAULT_MISSING",
        )
    if live and not dry_run and not _live_allowed():
        return OnboardResult(
            success=False,
            message="ALLOW_LIVE_CURSOR_INJECTION=1 required for live group onboard",
            action="quad_group_onboard",
            error_code="LIVE_BLOCKED",
        )
    args: list[str] = []
    if dry_run:
        args.append("--dry-run")
    elif live:
        args.append("--live")
    if force:
        args.append("--force")
    code, out = _run_script("runtime/scripts/quad_group_onboard_001.py", args, root=root)
    success = code == 0 and "GROUP_ONBOARD=PASS" in out
    data: dict[str, Any] = {"exit_code": code}
    try:
        start = out.find("{")
        end = out.rfind("}")
        if start >= 0 and end > start:
            data["result"] = json.loads(out[start : end + 1])
    except json.JSONDecodeError:
        pass
    return OnboardResult(
        success=success,
        message=out[-1500:] if out else f"exit {code}",
        action="quad_group_onboard",
        data=data,
        error_code=None if success else "GROUP_ONBOARD_FAILED",
    )
